{
  "palette": {
    "bgBase": "#1A1A1A",
    "bgTopStrip": "#1A1A1A",
    "logoFill": "#1A1A1A",
    "logoText": "#E8E8E8",
    "comboBg": "#222222D2",
    "comboText": "#E8E8E8",
    "comboOutline": "#FFFFFF69",
    "buttonBg": "#282828D2",
    "buttonOn": "#447CB4DC",
    "buttonText": "#E8E8E8",
    "sectionButtonOn": "#528CC4DC",
    "sectionButtonTextOn": "#F5F5F5",
    "topFillColour": "#CCCCCC"
  },
  "editor": {
    "background": {
      "baseColour": "$bgBase",
      "imageDarkness": 150
    },
    "topStrip": {
      "fillColour": "$bgTopStrip",
      "cornerRadius": 12
    },
    "logo": {
      "fillColour": "$logoFill",
      "subtitle": {
        "colour": "$logoText",
        "fontSize": 14
      }
    },
    "layout": {
      "headerHeight": 120,
      "sectionGap": 10,
      "logoPanelWidth": 150,
      "gainPanelWidth": 100
    }
  },
  "topMenu": {
    "layout": {
      "rowHeight": 32,
      "sectionGap": 6,
      "sectionMinWidth": 230,
      "sectionMaxWidth": 330,
      "presetClusterMenuWidth": 94,
      "prevNextWidth": 26,
      "presetHorizontalPad": 5,
      "presetSmallGap": 8,
      "menuButtonMinWidth": 64,
      "menuButtonMaxWidth": 78,
      "menuButtonInset": 16
    },
    "buttons": {}
  },
  "styles": {
    "buttons": {
      "topMenuPreset": {
        "buttonColour": "$buttonBg",
        "buttonOnColour": "$buttonOn",
        "textColour": "$buttonText",
        "textOnColour": "$buttonText"
      },
      "topMenuSection": {
        "buttonColour": "$buttonBg",
        "buttonOnColour": "$sectionButtonOn",
        "textColour": "$buttonText",
        "textOnColour": "$sectionButtonTextOn"
      }
    },
    "combos": {
      "default": {
        "backgroundColour": "$comboBg",
        "textColour": "$comboText",
        "outlineColour": "$comboOutline"
      }
    }
  },
  "fx": {
    "panel": {
      "fillAlpha": 0,
      "strokeAlpha": 0,
      "cornerRadius": 10,
      "layout": {
        "padX": 12,
        "padY": 10
      }
    },
    "vibe": {
      "layout": { "padX": 10, "padY": 8 },
      "visual": {
        "borderPadding": 6,
        "cornerRadius": 8,
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour",
        "onLabel": {
          "text": "ON",
          "fontSize": 11.5,
          "textColour": "#E8E8E8",
          "bounds": { "x": 36, "y": 11, "width": 24, "height": 14 }
        }
      }
    },
    "delay": {
      "layout": { "padX": 10, "padY": 8 },
      "visual": {
        "borderPadding": 6,
        "cornerRadius": 8,
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour",
        "onLabel": {
          "text": "ON",
          "fontSize": 11.5,
          "textColour": "#E8E8E8",
          "bounds": { "x": 36, "y": 11, "width": 24, "height": 14 }
        }
      }
    },
    "reverb": {
      "layout": { "padX": 10, "padY": 8 },
      "visual": {
        "borderPadding": 6,
        "cornerRadius": 8,
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour",
        "onLabel": {
          "text": "ON",
          "fontSize": 11.5,
          "textColour": "#E8E8E8",
          "bounds": { "x": 36, "y": 11, "width": 24, "height": 14 }
        }
      }
    }
  },
  "osc": {
    "panel": {
      "fillAlpha": 0,
      "strokeAlpha": 0,
      "cornerRadius": 0,
      "layout": {
        "padX": 0,
        "padY": 0
      },
      "cardTitle": {
        "fontSize": 11
      }
    },
    "subOsc": {
      "visual": {
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour"
      }
    },
    "oscillator": {
      "visual": {
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour"
      }
    },
    "lfo": {
      "visual": {
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour"
      }
    }
  },
  "flt": {
    "panel": {
      "fillAlpha": 0.14,
      "strokeAlpha": 0.75,
      "cornerRadius": 10,
      "layout": {
        "padX": 12,
        "padY": 10
      },
      "card": {
        "fillAlpha": 0.1,
        "topFillAlpha": 0.1,
        "topFillColour": "$topFillColour",
        "cornerRadius": 8,
        "strokeThickness": 1.2,
        "strokeColour": "#DCE8FC58",
        "title": {
          "fontSize": 11
        }
      }
    }
  },
  "mix": {
    "panel": {
      "fillAlpha": 0.14,
      "strokeAlpha": 0.75,
      "cornerRadius": 10,
      "layout": {
        "padX": 14,
        "padY": 12
      }
    }
  },
  "env": {
    "panel": {
      "fillAlpha": 0,
      "strokeAlpha": 0,
      "cornerRadius": 0,
      "layout": {
        "padX": 12,
        "padY": 10
      }
    },
    "envelope": {
      "background": "#0A120A9B",
      "outline": "#66BB6690",
      "topFillAlpha": 0.1,
      "topFillColour": "$topFillColour"
    }
  }
}
